# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Platform Wallet Configuration
# This is your platform's receiving wallet address for user deposits
# IMPORTANT: This is also the ADMIN wallet address - only this wallet can access admin features
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=your-solana-wallet-address-here

# Optional: Google OAuth Configuration
# Only needed if you want to enable Google sign-in
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id